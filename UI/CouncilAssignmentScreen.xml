<Prefab>
  <Constants>
  </Constants>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>

        <!-- Dimmed background -->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#000000CC" />

        <!-- Main panel -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1500" SuggestedHeight="920" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="BlankWhiteSquare_9" Color="#1A1A1AF0">
          <Children>

            <!-- Header band -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="110" HorizontalAlignment="Left" VerticalAlignment="Top">
              <Children>

                <!-- Ruling king/queen: portrait + name/title, far left -->
                <ImageIdentifierWidget DataSource="{KingPortrait}" ImageId="@Id" AdditionalArgs="@AdditionalArgs" TextureProviderName="@TextureProviderName" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="88" SuggestedHeight="88" HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="24" />
                <Widget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="126">
                  <Children>
                    <TextWidget Text="@KingName" WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="28" HorizontalAlignment="Center" VerticalAlignment="Top" Brush="Clan.TabControl.Text" />
                    <TextWidget Text="@KingSubtitleText" WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="24" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="30" Brush="Clan.TabControl.Text" />
                  </Children>
                </Widget>

                <!-- Kingdom banner + council title, centered -->
                <Widget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Children>
                    <ImageIdentifierWidget DataSource="{KingdomBanner}" ImageId="@Id" AdditionalArgs="@AdditionalArgs" TextureProviderName="@TextureProviderName" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="52" SuggestedHeight="52" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <TextWidget Text="@TitleText" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="64" Brush="Clan.TabControl.Text" />
                  </Children>
                </Widget>

                <ButtonWidget Command.Click="ExecuteClose" HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="10" MarginRight="10" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="40" SuggestedHeight="40" Brush="Popup.Delete.Button" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
                  <Children>
                    <TextWidget Text="X" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" Brush="Clan.TabControl.Text" HorizontalAlignment="Center" VerticalAlignment="Center" DoNotAcceptEvents="true" />
                  </Children>
                </ButtonWidget>

              </Children>
            </Widget>

            <!-- Council position list (left column) — click a row to open the candidate picker -->
            <ListPanel DataSource="{PositionList}" WidthSizePolicy="Fixed" SuggestedWidth="680" HeightSizePolicy="StretchToParent" HorizontalAlignment="Left" MarginLeft="40" MarginTop="130" MarginBottom="40" StackLayout.LayoutMethod="VerticalTopToBottom">
              <ItemTemplate>
                <ButtonWidget Command.Click="ExecuteSelect" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="86" MarginBottom="10" Brush="Header.Tab.Center" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
                  <Children>

                    <ImageIdentifierWidget DataSource="{Visual}" ImageId="@Id" AdditionalArgs="@AdditionalArgs" TextureProviderName="@TextureProviderName" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="66" SuggestedHeight="66" HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="10" DoNotAcceptEvents="true" />

                    <TextWidget Text="@PositionName" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="24" HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="90" MarginRight="10" MarginTop="16" Brush="Clan.TabControl.Text" DoNotAcceptEvents="true" />
                    <TextWidget Text="@AssigneeName" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="24" HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="90" MarginRight="10" MarginTop="46" Brush="Clan.TabControl.Text" DoNotAcceptEvents="true" />

                  </Children>
                </ButtonWidget>
              </ItemTemplate>
            </ListPanel>

            <!-- Kingsguard roster (right column, 6 slots) — click a slot to open the candidate picker -->
            <Widget WidthSizePolicy="Fixed" SuggestedWidth="680" HeightSizePolicy="StretchToParent" HorizontalAlignment="Right" MarginRight="40" MarginTop="130" MarginBottom="40">
              <Children>
                <TextWidget Text="Kingsguard" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Top" Brush="Clan.TabControl.Text" />
                <ListPanel DataSource="{KingsguardSlotList}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="35" StackLayout.LayoutMethod="VerticalTopToBottom">
                  <ItemTemplate>
                    <ButtonWidget Command.Click="ExecuteSelect" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="86" MarginBottom="10" Brush="Header.Tab.Center" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
                      <Children>

                        <ImageIdentifierWidget DataSource="{Visual}" ImageId="@Id" AdditionalArgs="@AdditionalArgs" TextureProviderName="@TextureProviderName" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="66" SuggestedHeight="66" HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="10" DoNotAcceptEvents="true" />

                        <TextWidget Text="@SlotLabel" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="24" HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="90" MarginRight="10" MarginTop="16" Brush="Clan.TabControl.Text" DoNotAcceptEvents="true" />
                        <TextWidget Text="@MemberName" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="24" HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="90" MarginRight="10" MarginTop="46" Brush="Clan.TabControl.Text" DoNotAcceptEvents="true" />

                      </Children>
                    </ButtonWidget>
                  </ItemTemplate>
                </ListPanel>
              </Children>
            </Widget>

          </Children>
        </Widget>

        <!-- Candidate picker overlay -->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsPickerVisible">
          <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#00000099" />

            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="780" SuggestedHeight="760" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="BlankWhiteSquare_9" Color="#1E1E1EFA">
              <Children>

                <TextWidget Text="@PickerTitleText" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="16" MarginLeft="60" MarginRight="60" Brush="Clan.TabControl.Text" />

                <ButtonWidget Command.Click="ExecuteUnassignSelected" HorizontalAlignment="Left" VerticalAlignment="Top" MarginTop="10" MarginLeft="10" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="130" SuggestedHeight="40" Brush="Header.Tab.Center" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
                  <Children>
                    <TextWidget Text="Unassign" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" Brush="Clan.TabControl.Text" HorizontalAlignment="Center" VerticalAlignment="Center" DoNotAcceptEvents="true" />
                  </Children>
                </ButtonWidget>

                <ButtonWidget Command.Click="ExecuteClosePicker" HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="10" MarginRight="10" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="40" SuggestedHeight="40" Brush="Popup.Delete.Button" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
                  <Children>
                    <TextWidget Text="X" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" Brush="Clan.TabControl.Text" HorizontalAlignment="Center" VerticalAlignment="Center" DoNotAcceptEvents="true" />
                  </Children>
                </ButtonWidget>

                <ScrollablePanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        MarginLeft="20" MarginRight="30" MarginTop="70" MarginBottom="20"
                        AutoHideScrollBars="true"
                        ClipRect="CandidateListClipRect"
                        InnerPanel="CandidateListClipRect\CandidateItemsList"
                        VerticalScrollbar="..\CandidateListScrollbar\Scrollbar">
                  <Children>
                    <Widget Id="CandidateListClipRect" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                      <Children>
                        <ListPanel Id="CandidateItemsList" DataSource="{CandidateList}"
                                WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                StackLayout.LayoutMethod="VerticalTopToBottom">
                          <ItemTemplate>
                            <ButtonWidget Command.Click="ExecuteSelect" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="76" MarginBottom="8" MarginRight="10" Brush="Header.Tab.Center" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
                              <Children>

                                <ImageIdentifierWidget DataSource="{Visual}" ImageId="@Id" AdditionalArgs="@AdditionalArgs" TextureProviderName="@TextureProviderName" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="58" SuggestedHeight="58" HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="10" DoNotAcceptEvents="true" />

                                <TextWidget Text="@Name" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="82" Brush="Clan.TabControl.Text" DoNotAcceptEvents="true" />
                                <TextWidget Text="@RelevantSkillText" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="15" Brush="Clan.TabControl.Text" DoNotAcceptEvents="true" />

                              </Children>
                            </ButtonWidget>
                          </ItemTemplate>
                        </ListPanel>
                      </Children>
                    </Widget>
                  </Children>
                </ScrollablePanel>
                <Standard.VerticalScrollbar Id="CandidateListScrollbar"
                        HeightSizePolicy="StretchToParent"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        MarginTop="70" MarginBottom="20" MarginRight="6" />

              </Children>
            </Widget>
          </Children>
        </Widget>

      </Children>
    </Widget>
  </Window>
</Prefab>
