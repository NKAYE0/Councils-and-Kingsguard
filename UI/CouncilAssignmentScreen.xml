<Prefab>
  <Constants>
  </Constants>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>

        <!-- Dimmed background -->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.7" />

        <!-- Main popup -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1570" SuggestedHeight="970" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Children>
            <!-- Visible window, inset so the close button sits fully inside the outer container and is clickable everywhere -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="35" MarginRight="35" MarginTop="35" MarginBottom="35">
              <Children>

                <!-- Native popup canvas, gradient and ornate frame -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="StdAssets\Popup\order_popup_canvas" />
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="StdAssets\Popup\canvas_gradient" />
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="frame_9" ExtendLeft="18" ExtendTop="18" ExtendRight="18" ExtendBottom="18" />

                <!-- Title plate -->
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="640" SuggestedHeight="60" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="22" Sprite="StdAssets\Popup\popper" Color="#DAE374FF">
                  <Children>
                    <TextWidget Text="@TitleText" WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="44" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="Info.Text" Brush.FontSize="26" />
                  </Children>
                </Widget>

                <!-- Ruler portrait, name and title (top left) -->
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="120" SuggestedHeight="90" HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="30" MarginTop="18" Sprite="StdAssets\Popup\tuple_portrait_slot">
                  <Children>
                    <ImageIdentifierWidget DataSource="{KingPortrait}" ImageId="@Id" AdditionalArgs="@AdditionalArgs" TextureProviderName="@TextureProviderName" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="6" MarginRight="6" MarginTop="6" MarginBottom="6" />
                  </Children>
                </Widget>
                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="162" MarginTop="34" StackLayout.LayoutMethod="VerticalTopToBottom">
                  <Children>
                    <TextWidget Text="@KingName" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" MaxWidth="260" Brush="Popup.Tuple.Text" Brush.FontSize="24" Brush.TextHorizontalAlignment="Left" />
                    <TextWidget Text="@KingSubtitleText" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" MaxWidth="260" MarginTop="4" Brush="Popup.Timer.Text" Brush.FontSize="18" Brush.TextHorizontalAlignment="Left" />
                  </Children>
                </ListPanel>

                <!-- Kingdom banner, masked into the native pennant shape (top right) -->
                <MaskedTextureWidget DataSource="{KingdomBanner}" ImageId="@Id" AdditionalArgs="@AdditionalArgs" TextureProviderName="@TextureProviderName" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="75" SuggestedHeight="95" HorizontalAlignment="Right" VerticalAlignment="Top" MarginRight="50" MarginTop="12" Brush="Flat.Tuple.Banner.Small" IsDisabled="true" />


                <!-- Two columns: council (left) and Kingsguard (right) -->
                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" HorizontalAlignment="Center" MarginTop="125" MarginBottom="35" StackLayout.LayoutMethod="HorizontalLeftToRight">
                  <Children>

                    <!-- Council column -->
                    <Widget WidthSizePolicy="Fixed" SuggestedWidth="680" HeightSizePolicy="StretchToParent" MarginRight="20">
                      <Children>
                        <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Panel.Dent" Brush.ColorFactor="0.2" />

                        <TextWidget Text="Small Council" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="36" VerticalAlignment="Top" MarginTop="8" MarginLeft="24" MarginRight="24" Brush="Popup.Tuple.Text" Brush.FontSize="24" Brush.TextHorizontalAlignment="Left" />
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" VerticalAlignment="Top" MarginTop="46" MarginLeft="40" MarginRight="40" Sprite="GradientDivider_9" AlphaFactor="0.6" />

                        <!-- Click a seat to open the candidate picker -->
                        <ListPanel DataSource="{PositionList}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="12" MarginRight="12" MarginTop="56" MarginBottom="6" StackLayout.LayoutMethod="VerticalTopToBottom">
                          <ItemTemplate>
                            <ButtonWidget Command.Click="ExecuteSelect" IsSelected="@IsSelected" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="86" MarginBottom="6" Brush="Crafting.Order.Card" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
                              <Children>

                                <!-- Portrait slot; the portrait itself is hidden while the seat is vacant -->
                                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="100" SuggestedHeight="75" HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="10" Sprite="StdAssets\Popup\tuple_portrait_slot" DoNotAcceptEvents="true">
                                  <Children>
                                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsHidden="@IsVacant" DoNotAcceptEvents="true">
                                      <Children>
                                        <ImageIdentifierWidget DataSource="{Visual}" ImageId="@Id" AdditionalArgs="@AdditionalArgs" TextureProviderName="@TextureProviderName" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="5" MarginRight="5" MarginTop="5" MarginBottom="5" DoNotAcceptEvents="true" />
                                      </Children>
                                    </Widget>
                                  </Children>
                                </Widget>

                                <TextWidget Text="@PositionName" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="28" VerticalAlignment="Top" MarginLeft="120" MarginRight="20" MarginTop="14" Brush="Popup.Tuple.Text" Brush.FontSize="22" Brush.TextHorizontalAlignment="Left" DoNotAcceptEvents="true" />
                                <TextWidget Text="@AssigneeName" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26" VerticalAlignment="Top" MarginLeft="120" MarginRight="240" MarginTop="46" Brush="Info.Text" Brush.FontSize="20" Brush.TextHorizontalAlignment="Left" DoNotAcceptEvents="true" />
                                <TextWidget Text="@RelevantStatText" WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="26" HorizontalAlignment="Right" VerticalAlignment="Top" MarginRight="20" MarginTop="46" Brush="Popup.Timer.Text" Brush.FontSize="18" DoNotAcceptEvents="true" />

                              </Children>
                            </ButtonWidget>
                          </ItemTemplate>
                        </ListPanel>
                      </Children>
                    </Widget>

                    <!-- Kingsguard column (6 slots) -->
                    <Widget WidthSizePolicy="Fixed" SuggestedWidth="680" HeightSizePolicy="StretchToParent" MarginLeft="20">
                      <Children>
                        <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Panel.Dent" Brush.ColorFactor="0.2" />

                        <TextWidget Text="Kingsguard" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="36" VerticalAlignment="Top" MarginTop="8" MarginLeft="24" MarginRight="24" Brush="Popup.Tuple.Text" Brush.FontSize="24" Brush.TextHorizontalAlignment="Left" />
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" VerticalAlignment="Top" MarginTop="46" MarginLeft="40" MarginRight="40" Sprite="GradientDivider_9" AlphaFactor="0.6" />

                        <!-- Click a slot to open the candidate picker -->
                        <ListPanel DataSource="{KingsguardSlotList}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="12" MarginRight="12" MarginTop="56" MarginBottom="6" StackLayout.LayoutMethod="VerticalTopToBottom">
                          <ItemTemplate>
                            <ButtonWidget Command.Click="ExecuteSelect" IsSelected="@IsSelected" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="86" MarginBottom="6" Brush="Crafting.Order.Card" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
                              <Children>

                                <!-- Portrait slot; the portrait itself is hidden while the slot is vacant -->
                                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="100" SuggestedHeight="75" HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="10" Sprite="StdAssets\Popup\tuple_portrait_slot" DoNotAcceptEvents="true">
                                  <Children>
                                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsHidden="@IsVacant" DoNotAcceptEvents="true">
                                      <Children>
                                        <ImageIdentifierWidget DataSource="{Visual}" ImageId="@Id" AdditionalArgs="@AdditionalArgs" TextureProviderName="@TextureProviderName" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="5" MarginRight="5" MarginTop="5" MarginBottom="5" DoNotAcceptEvents="true" />
                                      </Children>
                                    </Widget>
                                  </Children>
                                </Widget>

                                <TextWidget Text="@SlotLabel" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="28" VerticalAlignment="Top" MarginLeft="120" MarginRight="20" MarginTop="14" Brush="Popup.Tuple.Text" Brush.FontSize="22" Brush.TextHorizontalAlignment="Left" DoNotAcceptEvents="true" />
                                <TextWidget Text="@MemberName" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26" VerticalAlignment="Top" MarginLeft="120" MarginRight="20" MarginTop="46" Brush="Info.Text" Brush.FontSize="20" Brush.TextHorizontalAlignment="Left" DoNotAcceptEvents="true" />

                              </Children>
                            </ButtonWidget>
                          </ItemTemplate>
                        </ListPanel>
                      </Children>
                    </Widget>

                  </Children>
                </ListPanel>

              </Children>
            </Widget>

            <!-- Native close button on the window's top-right corner -->
            <ButtonWidget Command.Click="ExecuteClose" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="70" SuggestedHeight="70" HorizontalAlignment="Right" VerticalAlignment="Top" Brush="Popup.CloseButton" />
          </Children>
        </Widget>

        <!-- Candidate picker overlay -->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsPickerVisible">
          <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.6" />

            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="890" SuggestedHeight="850" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Children>
                <!-- Visible window, inset so the close button sits fully inside the outer container and is clickable everywhere -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="35" MarginRight="35" MarginTop="35" MarginBottom="35">
                  <Children>

                    <!-- Native popup canvas, gradient and ornate frame -->
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="StdAssets\Popup\order_popup_canvas" />
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="StdAssets\Popup\canvas_gradient" />
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="frame_9" ExtendLeft="18" ExtendTop="18" ExtendRight="18" ExtendBottom="18" />

                    <!-- Title plate -->
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="760" SuggestedHeight="72" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="10" Sprite="StdAssets\Popup\popper" Color="#DAE374FF">
                      <Children>
                        <TextWidget Text="@PickerTitleText" WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="46" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="Info.Text" Brush.FontSize="26" />
                      </Children>
                    </Widget>


                    <!-- Candidate list area -->
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="30" MarginRight="30" MarginTop="100" MarginBottom="70">
                      <Children>
                        <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Panel.Dent" Brush.ColorFactor="0.2" />

                        <ScrollablePanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="2" MarginRight="2" MarginTop="2" MarginBottom="2" AutoHideScrollBars="true" ClipRect="CandidateListClipRect" InnerPanel="CandidateListClipRect\CandidateItemsList" VerticalScrollbar="..\CandidateListScrollbar">
                          <Children>
                            <Widget Id="CandidateListClipRect" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="10" MarginRight="16" MarginTop="10" MarginBottom="10" ClipContents="true">
                              <Children>
                                <ListPanel Id="CandidateItemsList" DataSource="{CandidateList}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                                  <ItemTemplate>
                                    <ButtonWidget Command.Click="ExecuteSelect" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="70" Brush="Popup.SelectionElement.Tuple" Brush.ColorFactor="0.6" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
                                      <Children>

                                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="86" SuggestedHeight="64" HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="20" Sprite="StdAssets\Popup\tuple_portrait_slot" DoNotAcceptEvents="true">
                                          <Children>
                                            <ImageIdentifierWidget DataSource="{Visual}" ImageId="@Id" AdditionalArgs="@AdditionalArgs" TextureProviderName="@TextureProviderName" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="5" MarginRight="5" MarginTop="5" MarginBottom="5" DoNotAcceptEvents="true" />
                                          </Children>
                                        </Widget>

                                        <TextWidget Text="@Name" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="120" MarginRight="200" Brush="Popup.Tuple.Text" Brush.FontSize="22" Brush.TextHorizontalAlignment="Left" DoNotAcceptEvents="true" />
                                        <TextWidget Text="@RelevantSkillText" WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" HorizontalAlignment="Right" MarginRight="20" Brush="Popup.Timer.Text" Brush.FontSize="18" DoNotAcceptEvents="true" />

                                      </Children>
                                    </ButtonWidget>
                                  </ItemTemplate>
                                </ListPanel>
                              </Children>
                            </Widget>

                            <!-- Soft fade over the list, as in native selection popups -->
                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="StdAssets\Popup\canvas_gradient" AlphaFactor="0.5" DoNotAcceptEvents="true" />
                          </Children>
                        </ScrollablePanel>

                        <!-- Native thin scrollbar -->
                        <ScrollbarWidget Id="CandidateListScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="4" HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="6" MarginTop="15" MarginBottom="15" AlignmentAxis="Vertical" Handle="CandidateListScrollbarHandle" MaxValue="100" MinValue="0">
                          <Children>
                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2" HorizontalAlignment="Center" Sprite="BlankWhiteSquare_9" Color="#5A4033FF" AlphaFactor="0.5" />
                            <ImageWidget Id="CandidateListScrollbarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="5" SuggestedHeight="10" HorizontalAlignment="Center" Brush="FaceGen.Scrollbar.Handle" />
                          </Children>
                        </ScrollbarWidget>
                      </Children>
                    </Widget>

                  </Children>
                </Widget>

                <!-- Native close button on the window's top-right corner -->
                <ButtonWidget Command.Click="ExecuteClosePicker" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="70" SuggestedHeight="70" HorizontalAlignment="Right" VerticalAlignment="Top" Brush="Popup.CloseButton" />

                <!-- Unassign button (native popup button on the bottom edge, inside the outer container so it is fully clickable) -->
                <ButtonWidget Command.Click="ExecuteUnassignSelected" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="286" SuggestedHeight="82" HorizontalAlignment="Center" VerticalAlignment="Bottom" PositionYOffset="1" Brush="Standard.PopupBackButton" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
                  <Children>
                    <TextWidget Text="Unassign" WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" HorizontalAlignment="Center" Brush="CharacterDeveloper.PerkPopup.ButtonText" DoNotAcceptEvents="true" />
                  </Children>
                </ButtonWidget>
              </Children>
            </Widget>
          </Children>
        </Widget>

      </Children>
    </Widget>
  </Window>
</Prefab>
